{
  "name": "puranova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Puranova — a mobile-first water-fasting tracker with metabolic-stage countdown, personalized hydration/electrolyte scheduling, and refeed protocol.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
